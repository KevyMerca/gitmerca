#compdef git-wrapup

# Zsh completion for git-wrapup
# Install: Copy to a directory in your $fpath or source this file

_git-wrapup() {
    local -a options
    options=(
        '(-h --help)'{-h,--help}'[Show help message]'
        '(-v --version)'{-v,--version}'[Show version information]'
        '(-b --branch)'{-b,--branch}'[Create or switch to branch]:branch:__git_branch_names'
        '(-n --no-changeset)'{-n,--no-changeset}'[Skip running pnpm changeset]'
        '(-d --dry-run)'{-d,--dry-run}'[Show what would be done without making changes]'
    )

    _arguments -C \
        $options \
        '1:commit message:'
}

# Helper to get git branch names
__git_branch_names() {
    local -a branches
    branches=(${${(f)"$(git branch --format='%(refname:short)' 2>/dev/null)"}})
    
    if (( ${#branches} )); then
        _describe -t branches 'branches' branches
    fi
}

_git-wrapup "$@"
